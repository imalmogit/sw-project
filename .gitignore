# =============================================================================
#  .gitignore -- HW/SW Co-design Final Project
#
#  PRINCIPLE
#    Ignore what is REGENERATED by running the scripts.
#    Never ignore what is SUBMITTED or what is SOURCE.
#
#  Explicitly kept (see the negation rules at the bottom):
#    report_*.txt      required deliverable
#    script_*.sh       required deliverable
#    README.md         required deliverable
#    prompt.txt        required deliverable
#    *.svg             flame graphs -- the reports reference them
#    HDL sources, Python sources, docs
#
#  If you are unsure whether to ignore something, do not.
#  A missing deliverable costs more than a slightly noisy repository.
# =============================================================================


# -----------------------------------------------------------------------------
# Profiling output -- regenerated by the run scripts
# -----------------------------------------------------------------------------
perf.data
perf.data.old
perf.data.*
*.perf
*.perfdata

# Collapsed stack intermediates (input to flame-graph generation).
# The rendered .svg is kept; this intermediate is large and rebuildable.
*.folded
out.folded

# Raw harness output and logs
*.log
*.out
nohup.out


# -----------------------------------------------------------------------------
# Generated results directories -- DELIBERATELY NOT IGNORED WHOLESALE
#
# Do NOT add a blanket rule such as:
#     results/
#     results_*/
# Git does not descend into an ignored directory, so a later negation like
# "!*.svg" CANNOT rescue a file inside it. Flame graphs written into a results
# directory would then be silently left uncommitted -- while still being cited
# as evidence in the reports. This was verified with `git check-ignore`.
#
# Instead, results directories stay tracked and the heavy, regenerable
# artifacts inside them are excluded BY FILE TYPE (perf.data, *.folded, *.log
# above). That keeps flame graphs and profiling summaries -- which the reports
# reference as required evidence -- in version control.
#
# If a results directory grows too large to commit, exclude that specific
# path explicitly and say so in the README.
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
dist/
build/
develop-eggs/
.installed.cfg
pip-wheel-metadata/

# Cython intermediates -- the .pyx source is KEPT, the generated C is not
*.c.orig
cython_debug/

# Test and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/


# -----------------------------------------------------------------------------
# Virtual environments -- never commit these
# -----------------------------------------------------------------------------
venv/
venv*/
.venv/
env/
ENV/
*-venv/
venv-dbg/
pyvenv.cfg


# -----------------------------------------------------------------------------
# HDL build products and waveforms
# HDL SOURCE (.v .sv .vhd .py) is kept -- only build output is ignored.
# -----------------------------------------------------------------------------
*.vcd
*.fst
*.fst.hier
*.ghw
*.shm/
*.wlf
transcript

# Simulator output
*.vvp
a.out
simv
simv.daidir/
csrc/
obj_dir/
work/
xsim.dir/
*.jou
*.str
*.pb

# Synthesis output (not required by this project, but harmless to exclude)
*.bit
*.bin
*.edif
*.blif
*.json.synth


# -----------------------------------------------------------------------------
# Compiled binaries and object files
# -----------------------------------------------------------------------------
*.o
*.obj
*.a
*.lib
*.exe
*.dll
*.dylib


# -----------------------------------------------------------------------------
# Large local artifacts that must never be committed
# -----------------------------------------------------------------------------
*.img
*.qcow2
*.iso
*.tar
*.tar.gz
*.tgz
*.zip


# -----------------------------------------------------------------------------
# Editor, OS and temporary files
# -----------------------------------------------------------------------------
*~
*.swp
*.swo
*.bak
*.tmp
*.temp
.DS_Store
Thumbs.db
.vscode/
.idea/
*.sublime-workspace


# =============================================================================
#  NEGATIONS -- these are deliverables or source, and are always tracked
#  even if a rule above would otherwise match them.
# =============================================================================

# Required deliverables
!README.md
!prompt.txt
!report_*.txt
!script_*.sh
!.gitignore

# Documentation and templates
!docs/
!docs/**
!templates/
!templates/**
!scripts/
!scripts/**

# Flame graphs -- referenced by the reports as required evidence
!*.svg
!**/*.svg

# HDL source
!*.v
!*.sv
!*.vh
!*.svh
!*.vhd

# Python and Cython source
!*.py
!*.pyx
!*.pxd

# Build definitions (source, not output)
!Makefile
!makefile
!*.mk
!*.toml
!*.cfg
!MANIFEST

# Benchmark data files that ship with a custom benchmark and are needed to run
# it. Add explicit exceptions here if a benchmark requires an input archive,
# for example:
#   !benchmarks/**/data/*

# third-party tooling, cloned not authored
tools/FlameGraph/
